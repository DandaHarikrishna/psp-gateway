<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://nman.com/apiagent"
        xmlns="http://nman.com/apiagent"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <!-- ============================================================
         Reusable Account ID Type
         ============================================================ -->

    <xs:simpleType name="AccountIdType">

        <xs:annotation>
            <xs:documentation>
                Unique identifier of the account to which the VPA
                will be associated.
            </xs:documentation>
        </xs:annotation>

        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:whiteSpace value="collapse"/>
        </xs:restriction>

    </xs:simpleType>


    <!-- ============================================================
         Reusable VPA Type
         ============================================================ -->

    <xs:simpleType name="VpaType">

        <xs:annotation>
            <xs:documentation>
                Virtual Payment Address consisting of a local part
                and a handle separated by an @ symbol.
            </xs:documentation>
        </xs:annotation>

        <xs:restriction base="xs:string">

            <!-- VPA local part: 2-50 characters -->
            <!-- VPA handle: 2-30 characters -->

            <xs:pattern
                    value="[a-zA-Z0-9._-]{2,50}@[a-zA-Z0-9.-]{2,30}"/>

            <!-- Total VPA length:
                 Minimum = 2 + 1 + 2 = 5
                 Maximum = 50 + 1 + 30 = 81 -->

            <xs:minLength value="5"/>
            <xs:maxLength value="81"/>
            <xs:whiteSpace value="collapse"/>

        </xs:restriction>

    </xs:simpleType>


    <!-- ============================================================
         Reusable Reference ID Type
         ============================================================ -->

    <xs:simpleType name="ReferenceIdType">

        <xs:annotation>
            <xs:documentation>
                Client-provided reference identifier used for
                request tracing, reconciliation, or idempotency.
            </xs:documentation>
        </xs:annotation>

        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="100"/>
            <xs:whiteSpace value="collapse"/>
        </xs:restriction>

    </xs:simpleType>


    <!-- ============================================================
         Create VPA Request
         ============================================================ -->

    <xs:element name="CreateVpaRequest">

        <xs:annotation>
            <xs:documentation>
                Request to create and optionally set a Virtual Payment
                Address (VPA) as the primary VPA for an account.
            </xs:documentation>
        </xs:annotation>

        <xs:complexType>

            <xs:sequence>

                <!-- =================================================
                     Account ID
                     ================================================= -->

                <xs:element
                        name="accountId"
                        type="AccountIdType">

                    <xs:annotation>
                        <xs:documentation>
                            Required. Unique account identifier for
                            which the VPA is being created.
                        </xs:documentation>
                    </xs:annotation>

                </xs:element>


                <!-- =================================================
                     VPA
                     ================================================= -->

                <xs:element
                        name="vpa"
                        type="VpaType">

                    <xs:annotation>
                        <xs:documentation>
                            Required. Virtual Payment Address.

                            Format:
                            local-part@handle

                            Local part:
                            2 to 50 characters consisting of
                            letters, digits, dot, underscore or hyphen.

                            Handle:
                            2 to 30 characters consisting of
                            letters, digits, dot or hyphen.
                        </xs:documentation>
                    </xs:annotation>

                </xs:element>


                <!-- =================================================
                     Set As Primary
                     ================================================= -->

                <xs:element
                        name="setAsPrimary"
                        type="xs:boolean"
                        minOccurs="0"
                        default="false">

                    <xs:annotation>
                        <xs:documentation>
                            Optional. Indicates whether the newly
                            created VPA should be configured as the
                            primary VPA for the account.
                            Defaults to false when omitted.
                        </xs:documentation>
                    </xs:annotation>

                </xs:element>


                <!-- =================================================
                     Reference ID
                     ================================================= -->

                <xs:element
                        name="referenceId"
                        type="ReferenceIdType"
                        minOccurs="0">

                    <xs:annotation>
                        <xs:documentation>
                            Optional. Client-generated reference
                            identifier used for request tracking,
                            reconciliation, or idempotency.
                        </xs:documentation>
                    </xs:annotation>

                </xs:element>

            </xs:sequence>

        </xs:complexType>

    </xs:element>

</xs:schema>
