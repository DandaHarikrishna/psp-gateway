<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================
         Spring Boot
         ========================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- =========================================================
         Project Information
         ========================================================= -->
    <groupId>com.nman</groupId>
    <artifactId>psp-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>psp-gateway</name>
    <description>PSP Gateway for UPI transaction processing</description>

    <!-- =========================================================
         Properties
         ========================================================= -->
    <properties>
        <java.version>21</java.version>

        <jaxb-api.version>4.0.4</jaxb-api.version>
        <jaxb-runtime.version>4.0.6</jaxb-runtime.version>
        <jaxb-plugin.version>4.0.0</jaxb-plugin.version>
    </properties>

    <!-- =========================================================
         Dependencies
         ========================================================= -->
    <dependencies>

        <!-- REST API / Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Kafka -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JAXB API -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>${jaxb-api.version}</version>
        </dependency>

        <!-- JAXB Runtime -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>${jaxb-runtime.version}</version>
        </dependency>

        <!-- Development only -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =========================================================
         Build
         ========================================================= -->
    <build>

        <!-- Produces target/psp-gateway.jar -->
        <finalName>psp-gateway</finalName>

        <plugins>

            <!-- Creates executable Spring Boot JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Generate JAXB classes from XSD -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>${jaxb-plugin.version}</version>

                <executions>
                    <execution>
                        <id>xsd-to-java</id>

                        <goals>
                            <goal>xjc</goal>
                        </goals>

                        <configuration>

                            <sources>
                                <source>
                                    ${project.basedir}/src/main/resources/xsd/CreateVpaRequest.xsd
                                </source>
                            </sources>

                            <packageName>
                                com.nman.apiagent.xml.generated
                            </packageName>

                            <outputDirectory>
                                ${project.build.directory}/generated-sources/jaxb
                            </outputDirectory>

                            <clearOutputDir>true</clearOutputDir>

                        </configuration>

                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

</project>